[Unit]
Description=Run DuckDNS update every 5 minutes

[Timer]
# Fire shortly after boot, then every 5 minutes. Persistent=true means a
# missed run (Pi powered off) fires once on next boot rather than waiting
# for the next slot — which matters, because the IP most likely changed
# while it was off.
OnBootSec=1min
OnUnitActiveSec=5min
Persistent=true

[Install]
WantedBy=timers.target
